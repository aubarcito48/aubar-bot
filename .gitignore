# Ejemplos y bibliotecas descargados de Waveshare (ver enlaces en readme.md).
/referencias/

# Resultados de compilacion de Arduino / ESP32.
/build/
**/build/
/.pio/
*.bin
*.elf
*.map
*.o
*.a
*.d
*.hex

# Cache de Python y entornos locales.
__pycache__/
*.py[cod]
.venv/
venv/

# Dependencias y resultados de futuras herramientas web.
node_modules/
/dist/
/models/
/tmp/

# Credenciales locales. Las plantillas si se pueden versionar.
.env
.env.*
!.env.example
!.env.template

# Archivos temporales del sistema y editores.
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.swp
*~

# AUBAR: sources are the supplied videos and optimized WebP stills.
# Keep authoring duplicates, decoded PNGs and reproducible frame exports local.
/newAUBAR/**/revision-video/**
!/newAUBAR/**/revision-video/.gitkeep
/newAUBAR/**/animaciones-original/formato jfif/**
!/newAUBAR/**/animaciones-original/formato jfif/.gitkeep
/newAUBAR/**/animaciones-sin-fondo/formato png/**
!/newAUBAR/**/animaciones-sin-fondo/formato png/.gitkeep
/newAUBAR/nahue_pick.png
/newAUBAR/**/frames-preparados/*/con-fondo/
/newAUBAR/**/frames-preparados/*/sin-fondo/
/newAUBAR/**/frames-preparados/*/atlas.webp
/newAUBAR/**/frames-preparados/*/neutral.webp
/newAUBAR/**/frames-preparados/*/vista-previa.webp
/newAUBAR/**/frames-preparados/poses-estaticas.webp
/newAUBAR/**/frames-preparados/firmware/asset-map.json
/firmware/KirbyPantalla/portrait_asset_path.h
