# Ejemplos y bibliotecas descargados de Waveshare.
/referencias/

# Resultados de compilacion de Arduino / ESP32.
/build/
**/build/
/.pio/
*.bin
*.elf
*.map
*.o
*.a
*.d
*.hex

# Cache de Python y entornos locales.
__pycache__/
*.py[cod]
.venv/
venv/

# Dependencias y resultados de futuras herramientas web.
node_modules/
/dist/
/models/
/tmp/

# Credenciales locales. Las plantillas si se pueden versionar.
.env
.env.*
!.env.example
!.env.template

# Archivos temporales del sistema y editores.
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.swp
*~

# AUBAR: sources are the supplied videos and optimized WebP stills.
# Keep authoring duplicates, decoded PNGs and reproducible frame exports local.
/assets/avatar/**/revision-video/**
!/assets/avatar/**/revision-video/.gitkeep
/assets/avatar/**/animaciones-original/formato jfif/**
!/assets/avatar/**/animaciones-original/formato jfif/.gitkeep
/assets/avatar/**/animaciones-sin-fondo/formato png/**
!/assets/avatar/**/animaciones-sin-fondo/formato png/.gitkeep
/assets/avatar/nahue_pick.png
/assets/avatar/**/frames-preparados/*/con-fondo/
/assets/avatar/**/frames-preparados/*/sin-fondo/
/assets/avatar/**/frames-preparados/*/atlas.webp
/assets/avatar/**/frames-preparados/*/neutral.webp
/assets/avatar/**/frames-preparados/*/vista-previa.webp
/assets/avatar/**/frames-preparados/poses-estaticas.webp
/assets/avatar/**/frames-preparados/firmware/asset-map.json
/firmware/KirbyPantalla/portrait_asset_path.h
