# Copiar a .env y completar la clave solo en ese archivo local.
# La clave no debe incluir comillas si no las necesita ni espacios.
GROQ_API_KEY=

# Modelo configurable; la disponibilidad se verifica al consultar Groq.
GROQ_MODEL=openai/gpt-oss-20b

# Tiempo maximo de espera por consulta, en segundos (1 a 120).
GROQ_TIMEOUT_SECONDS=20

# Director de actuación: groq conserva la versión actual; local prueba Aubar Director.
# El piloto local usa una sola consulta a Groq para el texto y no llama al director remoto.
AUBAR_DIRECTOR=groq

# Fuentes de solo lectura. Vacías desactivan cada integración.
AUBAR_PORTFOLIO_API_URL=https://portfolio-backend-6ecn.onrender.com/api/v1/
# Presupuesto separado de Groq para despertar el backend gratuito (1 a 90 segundos).
AUBAR_SOURCES_TIMEOUT_SECONDS=60
# El microservicio WhatsApp debe estar iniciado; este endpoint solo consulta estado.
AUBAR_WHATSAPP_HEALTH_URL=http://127.0.0.1:3000/health

# Control privado: mismo token de 64 caracteres hexadecimales que en whatsapp-bot.
# El token se genera localmente; dejar ambos vacíos desactiva envíos y notificaciones.
AUBAR_WHATSAPP_CONTROL_URL=
AUBAR_CONTROL_TOKEN=
