# Copiar a .env y completar la clave solo en ese archivo local.
# La clave no debe incluir comillas si no las necesita ni espacios.
GROQ_API_KEY=

# Modelo configurable; la disponibilidad se verifica al consultar Groq.
GROQ_MODEL=openai/gpt-oss-20b

# Tiempo maximo de espera por consulta, en segundos (1 a 120).
GROQ_TIMEOUT_SECONDS=20
