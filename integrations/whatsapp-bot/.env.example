# Existing public portfolio backend. Never put a Groq or Meta key here.
PORTFOLIO_API_URL=https://portfolio-backend-6ecn.onrender.com/api/v1/chat/
API_TIMEOUT_MS=90000

# Comma-separated international numbers, digits only, of your test contacts.
# Leave empty until you choose them: npm start will refuse to connect.
# The number that sends the test must be different from the linked bot number.
TEST_CONTACTS=

# Keep QR visible only in your private local terminal.
SHOW_QR=true

# Private session keys. Move this directory to a persistent volume on a server.
AUTH_DIR=.data

# Optional health endpoint. Authenticated desktop control is loopback-only.
HEALTH_HOST=127.0.0.1
PORT=3000

# Shared with Botbar. Empty disables desktop events and outbound control.
# Generate locally; never publish the token. Exactly 64 hexadecimal characters.
AUBAR_CONTROL_TOKEN=
